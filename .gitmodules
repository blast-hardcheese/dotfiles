[submodule ".urxvt/ext-repos/urxvt-font-size"]
	path = .urxvt/ext-repos/urxvt-font-size
	url = https://github.com/majutsushi/urxvt-font-size
[submodule ".tmux/plugins/tpm"]
	path = .config/tmux/plugins/tpm
	url = https://github.com/tmux-plugins/tpm
[submodule ".tmux/plugins/tmux-sensible"]
	path = .config/tmux/plugins/tmux-sensible
	url = git@github.com:tmux-plugins/tmux-sensible.git
[submodule ".tmux/plugins/tmux-cluster"]
	path = .config/tmux/plugins/tmux-cluster
	url = https://git::@github.com/davidscholberg/tmux-cluster
[submodule ".config/k9s-repo"]
	path = .config/k9s-repo
	url = git@github.com:derailed/k9s.git
